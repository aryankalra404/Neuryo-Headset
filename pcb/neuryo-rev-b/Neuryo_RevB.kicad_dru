(version 1)
# Clearance rules translated from the original Altium board (EEG_PCB.PcbDoc, rule "Clearance",
# OBJECTCLEARANCES matrix in 1e-7 inch; GENERICCLEARANCE 10 mil for every pair not in the matrix).
# The KiCad importer only brought over the generic 10 mil, which made 499 false DRC errors.
(rule "altium generic 10 mil"
  (constraint clearance (min 0.254mm)))
(rule "altium track/arc to track/arc 0.1 mm (39370)"
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && (B.Type == 'Track' || B.Type == 'Arc')")
  (constraint clearance (min 0.1mm)))
(rule "altium track/arc to SMD pad 0.1 mm (39370)"
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && B.Type == 'Pad' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.1mm)))
(rule "altium track/arc to via 0.2 mm (78740)"
  (condition "(A.Type == 'Track' || A.Type == 'Arc') && B.Type == 'Via'")
  (constraint clearance (min 0.2mm)))
(rule "altium SMD pad to SMD pad 0.15 mm (59055)"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Type == 'Pad' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))
(rule "altium via to fill/poly/region 0.2 mm (78740)"
  (condition "A.Type == 'Via' && B.Type == 'Zone'")
  (constraint clearance (min 0.2mm)))
(rule "altium via to hole 0.2 mm (78740)"
  (condition "A.Type == 'Via'")
  (constraint hole_clearance (min 0.2mm)))
(rule "altium SMD pad to hole 0.45 mm (177165)"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD'")
  (constraint hole_clearance (min 0.45mm)))
# Altium BoardOutlineClearance 20 mil
(rule "altium board outline 20 mil"
  (constraint edge_clearance (min 0.508mm)))
# Altium DiffPairsRouting (8-10 mil) applied only to the USB pair, which rev B removes; not translated.
